# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_LOGIN=your_github_username_here

# LLM Configuration
# Supported providers:
#   - google_genai: Gemini (gemini-2.0-flash-exp, gemini-2.5-pro)
#   - anthropic: Claude (claude-sonnet-4-5-20250929, claude-haiku-4-5-20251001)
#   - openai: GPT (gpt-4o, gpt-4o-mini, gpt-4-turbo)
LLM_MODEL=gemini-2.0-flash-exp
LLM_PROVIDER=google_genai

# Google AI Configuration (for google_genai provider)
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Configuration (for anthropic provider)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI Configuration (for openai provider)
OPENAI_API_KEY=your_openai_api_key_here
